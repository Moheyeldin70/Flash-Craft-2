rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidMediaType(mediaType) {
      return mediaType in ['NONE', 'IMAGE', 'AUDIO'];
    }

    // --- ENTITY VALIDATION BLUEPRINTS ---
    function isValidDeck(data, userId) {
      return data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
             data.description is string && data.description.size() <= 300 &&
             data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 16 &&
             data.colorHex.matches('^#[0-9A-Fa-f]{6,8}$') &&
             data.iconName is string && data.iconName.size() >= 1 && data.iconName.size() <= 40 &&
             data.cardCount is int && data.cardCount >= 0 && data.cardCount <= 10000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFlashcard(data, userId) {
      return data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             isValidId(data.deckId) &&
             data.front is string && data.front.size() >= 1 && data.front.size() <= 1000 &&
             data.back is string && data.back.size() >= 1 && data.back.size() <= 2000 &&
             data.hint is string && data.hint.size() <= 300 &&
             data.tags is list && data.tags.size() <= 10 &&
             (data.tags.size() == 0 || (data.tags[0] is string && data.tags[0].size() <= 40)) &&
             data.frontMediaUri is string && data.frontMediaUri.size() <= 500 &&
             data.frontMediaType is string && data.frontMediaType.size() <= 16 && isValidMediaType(data.frontMediaType) &&
             data.frontMediaName is string && data.frontMediaName.size() <= 120 &&
             data.backMediaUri is string && data.backMediaUri.size() <= 500 &&
             data.backMediaType is string && data.backMediaType.size() <= 16 && isValidMediaType(data.backMediaType) &&
             data.backMediaName is string && data.backMediaName.size() <= 120 &&
             data.repetitions is int && data.repetitions >= 0 && data.repetitions <= 100000 &&
             data.intervalDays is number && data.intervalDays >= 0 && data.intervalDays <= 36500 &&
             data.easeFactor is number && data.easeFactor >= 1.3 && data.easeFactor <= 5.0 &&
             data.stability is number && data.stability >= 0 && data.stability <= 36500 &&
             data.difficulty is number && data.difficulty >= 1.0 && data.difficulty <= 10.0 &&
             data.leitnerBox is int && data.leitnerBox >= 1 && data.leitnerBox <= 5 &&
             data.dueAtMillis is int && data.dueAtMillis >= 0 &&
             data.lastReviewedMillis is int && data.lastReviewedMillis >= 0 &&
             data.lapses is int && data.lapses >= 0 && data.lapses <= 100000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudyLog(data, userId) {
      return data.userId is string && data.userId == userId && data.userId.size() <= 128 &&
             data.dateKey is string && data.dateKey.size() >= 1 && data.dateKey.size() <= 20 &&
             data.reviewsCount is int && data.reviewsCount >= 0 && data.reviewsCount <= 100000 &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 100000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- USER-SCOPED SUBCOLLECTIONS ---
    match /users/{userId}/decks/{deckId} {
      allow get: if isOwner(userId) && isValidId(deckId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(deckId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'description', 'colorHex', 'iconName',
                         'cardCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'description', 'colorHex', 'iconName',
                         'cardCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidDeck(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(deckId) &&
                       isValidDeck(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Edit deck metadata
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'colorHex', 'iconName', 'updatedAt']) ||
                         // Action 2: Sync card count
                         incoming().diff(existing()).affectedKeys().hasOnly(['cardCount', 'updatedAt'])
                       );

      allow delete: if isOwner(userId) && isValidId(deckId);
    }

    match /users/{userId}/cards/{cardId} {
      allow get: if isOwner(userId) && isValidId(cardId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(cardId) &&
                       incoming().keys().hasAll([
                         'userId', 'deckId', 'front', 'back', 'hint', 'tags',
                         'frontMediaUri', 'frontMediaType', 'frontMediaName',
                         'backMediaUri', 'backMediaType', 'backMediaName',
                         'repetitions', 'intervalDays', 'easeFactor', 'stability',
                         'difficulty', 'leitnerBox', 'dueAtMillis', 'lastReviewedMillis',
                         'lapses', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'deckId', 'front', 'back', 'hint', 'tags',
                         'frontMediaUri', 'frontMediaType', 'frontMediaName',
                         'backMediaUri', 'backMediaType', 'backMediaName',
                         'repetitions', 'intervalDays', 'easeFactor', 'stability',
                         'difficulty', 'leitnerBox', 'dueAtMillis', 'lastReviewedMillis',
                         'lapses', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidFlashcard(incoming(), userId) &&
                       existsAfter(/databases/$(database)/documents/users/$(userId)/decks/$(incoming().deckId));

      allow update: if isOwner(userId) &&
                       isValidId(cardId) &&
                       isValidFlashcard(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().deckId == existing().deckId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Edit card content & media
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'front', 'back', 'hint', 'tags',
                           'frontMediaUri', 'frontMediaType', 'frontMediaName',
                           'backMediaUri', 'backMediaType', 'backMediaName',
                           'updatedAt'
                         ]) ||
                         // Action 2: Record spaced-repetition study review or reset progress
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'repetitions', 'intervalDays', 'easeFactor', 'stability',
                           'difficulty', 'leitnerBox', 'dueAtMillis', 'lastReviewedMillis',
                           'lapses', 'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(cardId);
    }

    match /users/{userId}/studyLogs/{logId} {
      allow get: if isOwner(userId) && isValidId(logId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(logId) &&
                       incoming().keys().hasAll([
                         'userId', 'dateKey', 'reviewsCount', 'correctCount', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'dateKey', 'reviewsCount', 'correctCount', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidStudyLog(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(logId) &&
                       isValidStudyLog(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().dateKey == existing().dateKey &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'reviewsCount', 'correctCount', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(logId);
    }
  }
}
